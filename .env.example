# =============================================================================
# PLANTILLA de configuracion. Copia este archivo a .env y rellena tus valores.
#   cp .env.example .env        (Linux/Mac)
#   copy .env.example .env      (Windows CMD)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# O usa la opcion "Configurar entorno" del menu (main.py) que lo crea por ti.
#
# El .env NO se sube a git (esta en .gitignore). NUNCA pongas credenciales aqui
# en .env.example — este archivo es solo la plantilla de referencia.
# =============================================================================

# Credenciales AWS TEMPORALES (obtenidas del portal SSO / "aws configure sso").
# Caducan en horas: si ves "ExpiredToken", regeneralas y actualiza el .env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Region de trabajo.
AWS_DEFAULT_REGION=us-east-1

# ARN del rol IAM que EventBridge Scheduler asume para invocar Glue.
# Ejemplo de formato (NO es real):
#   arn:aws:iam::<ACCOUNT_ID>:role/<NOMBRE_DEL_ROL_SCHEDULER>
SCHEDULER_ROLE_ARN=


# =============================================================================
# DECISIONES PREVIAS (se aplican AL CREAR cada schedule)
#   Definelas ANTES de migrar (opcion "Decisiones previas" del menu) para que
#   cada schedule NAZCA correcto: hora local + grupo real. Asi NO hay que
#   reparar timezone/cron/grupos despues (eso fue lo tedioso la primera vez).
# =============================================================================

# Timezone objetivo. America/Santiago ajusta verano/invierno automaticamente.
TIMEZONE_MIGRACION=America/Santiago

# Horas a restar al cron para llevarlo a hora local de Chile:
#   3 = verano (UTC-3)   |   4 = invierno (UTC-4)   |   0 = NO tocar el cron
# Solo se convierte hora simple y listas de horas; la alta frecuencia y los
# casos dia-especifico-con-wrap se dejan o se marcan para revisar.
OFFSET_CRON=0

# Regla de grupos: SOLO el job principal exacto va al grupo de stored procedures;
# cualquier otro job va al grupo general de glue jobs.
JOB_PRINCIPAL=sdlf-bigdata-redshift-segmentation-schedule-glue-job
GRUPO_JOB_PRINCIPAL=datamanagement_stored_procedures
GRUPO_RESTO=sdlf_bigdata_glue_jobs
